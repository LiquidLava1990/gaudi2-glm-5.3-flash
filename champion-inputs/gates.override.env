# r4e gate settings for the BASE r4e cut (coordinator 2026-11-09 00:5x EST). r4e_run.sh sources this file before its defaults
# (R4E_GATES_OVERRIDE=none skips it). Base r4e = r4d + mixed-step key swap (manifest a78a0d65; W1 v2 and the pin off).
# Routed MoE is NOT in base r4e: it goes in r4e.1 only on S8 GO, and that cut gets its own gates.
# Required keys: the mixed-step key left after W1 v2 (reasoning vector FAIL 00:56, penalty set W1P FAIL 01:45) and the pin (r4e-A boot
# refusal 03:03) came out, plus lever 1 (its four lines stay checked by R4E_REQUIRED_LINES).
# No routed-MoE counters in base r4e: the verdict reads routed=OFF instead of a FAIL.
# No session pin in base r4e (coordinator 03:0x): pin=OFF instead of a FAIL; a pin line in the log or the pin flag set is a FAIL / HALT.
# Attention-only pin lines, glm53_attn_pin.py 2500dd37. Boot: `GLM53_ATTN_PIN armed HPU_GLM53_ATTN_PIN=1 groups=...`; every log_s:
# `GLM53_ATTN_PIN pinned_sessions= pinned_blocks= held_plans= local_hit_tokens= evicted_adopt_trim= evicted_pressure= evicted_cap= ...`
# (cumulative counters). Live = a counter line with local hits > 0: the pin served a turn from HBM, not just armed at boot.
PIN_LIVE_RE='GLM53_ATTN_PIN pinned_sessions=[0-9]+ .*local_hit_tokens=[1-9][0-9]*'
# turn_breakdown.py: the local-hit reading (group 1; cumulative) and the eviction line (a counter line with any eviction > 0).
PIN_LOCAL_HIT_RE='GLM53_ATTN_PIN pinned_sessions=.* local_hit_tokens=([0-9]+)'
PIN_EVICT_RE='GLM53_ATTN_PIN pinned_sessions=.*(evicted_adopt_trim|evicted_pressure|evicted_cap)=[1-9]'
# r4g-A: every r4g key it sets is required; the pin is off (replaces the base lines of R4E_REQUIRED_KEYS R4E_PIN_GATE R4E_ROUTED_GATE ROUTED_LINE_RE ROUTED_PIECES_KEY ROUTED_OVERFLOWS_KEY ROUTED_RERUNS_KEY ROUTED_MAX_OVERFLOW_PCT)
R4E_REQUIRED_KEYS='VLLM_GAUDI_MIXED_PROMPT_KEYS VLLM_DECODE_PRIORITY VLLM_GAUDI_SAMPLER_WARMUP_PENALTY HPU_GLM53_PENALTY_PROMPT_SET_STOCK HPU_GLM53_PENALTY_OUTPUT_BUCKET HPU_GLM53_PENALTY_FOLD HPU_GLM53_HBM_MARGIN_TIMED_REPLAYS HPU_GLM53_DEVICE_REPETITION_PENALTY HPU_GLM53_OFFLOAD_ROW_BUCKETS HPU_GLM53_RESERVE_VECTOR HPU_GLM53_KEYED_LOGITS VLLM_GAUDI_MIXED_PROMPT_KEYS HPU_GLM53_CAPTURE_EXECUTE_KEYS HPU_GLM53_ROUTED_COPY_FREE VLLM_RECURRENT_TAIL_FUSE HPU_GLM53_WIDTH_SHARD_KEYS HPU_GLM53_DECODE_SPLIT_DROP_ROWS VLLM_GAUDI_TARGETED_SAMPLER_WARMUP_BATCHES HPU_GLM53_QUERY_SHARD_DECODE_KEYS HPU_GLM53_DEFER_GRAPH_DESTROY HPU_GLM53_WIDTH_SHARD_DECODE_KEYS VLLM_RECURRENT_TAIL_FUSE_KEYED HPU_GLM53_RESERVE_SKIP_DISCARDED HPU_GLM53_DECODE_KPOOL_TILE_CEILING_FOR VLLM_BUCKETING_FROM_FILE VLLM_GAUDI_BOOTSTRAP_DECODE_BUCKETS VLLM_GAUDI_MIXED_PREFILL_TOKENS VLLM_ADAPTIVE_LONG_PREFILL_SINGLE_TOKENS HPU_GLM53_QUERY_SHARD_KEYS VLLM_GAUDI_MIXED_DECODE_WIDTHS HPU_GLM53_MOE_ORDERED_ACCUMULATE HPU_GLM53_ROUTED_COPY_FREE_TILE HPU_GLM53_ROUTED_COPY_FREE_CHUNK VLLM_MOE_CHUNK VLLM_MOE_TOKEN_BOUNDARY HPU_GLM53_NATIVE_ROUTED_GPT_MAX_TOKENS VLLM_DECODE_PRIORITY_MAX_SKIPPED_STEPS HPU_GLM53_DECODE_PAD_CHECK_WIDTHS HPU_GLM53_DECODE_PAD_UNCOMPARED_WIDTHS HPU_GLM53_MLA_WINDOW'
R4E_PIN_GATE=on
R4E_ROUTED_GATE=on
ROUTED_LINE_RE='ROUTED_COPY_FREE_LIVE live_calls='
ROUTED_PIECES_KEY=live_calls
ROUTED_OVERFLOWS_KEY=bypassed_traces
ROUTED_RERUNS_KEY=live_rows
ROUTED_MAX_OVERFLOW_PCT=0
# r4h7 serving, arm C3 = row8, the DEFAULT arm (make_serve_inputs.py), added to gates.override.env ff81824d9d70; R4E_REQUIRED_KEYS
# above gained every key of the arm. The keyed tail fuse is admitted only as an exact line of a baked ARM file.
R4E_ARM_ENV=/mnt/data1/declane-out/c1d-r4h7/r4h-arm-c3.env
R4E_ARM_ENV_SHA256=804fb5cba0d7d1b42025cd16aa2e3ec12e276db9312fe93047f5db490b446e4e
# lab_serve.py rewrites the copied unit argv to this; the image refuses a larger --max-model-len beside these keys.
LAB_MAX_MODEL_LEN=524288
# the level of a request that names none (owner 2026-11-14: containers at high, not max)
LAB_DEFAULT_REASONING_EFFORT=high
