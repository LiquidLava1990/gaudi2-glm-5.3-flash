# r4h8 serving levers (r4h7 row8 + lever 1 MLA whole-window gather + tail-first prompt slot), arm C3 = row8 (from serve-r4h8-row8-inputs + serve-r4h7-row8-tail-inputs) + decode gap 8 (owner 2026-11-14)
# without the arm's keys, then every served line of the baked ARM file /mnt/data1/declane-out/c1d-r4h7/r4h-arm-c3.env.
# Applied after final-config.env 5a465cc2 (later wins). KEY= serves the key empty. Needs --max-model-len 524288 (the gates file).
VLLM_DECODE_PRIORITY=phases
VLLM_DECODE_PRIORITY_MIXED=1
VLLM_DECODE_PRIORITY_MIN_DECODE_STEPS=8
VLLM_DECODE_PRIORITY_MAX_PREFILL_WAIT_S=8
VLLM_RECURRENT_TAIL_FUSE=1
HPU_GLM53_WIDTH_SHARD_KEYS=128:1024
HPU_GLM53_PENALTY_PROMPT_SET_STOCK=1
HPU_GLM53_ROUTED_COPY_FREE=1
VLLM_GAUDI_SAMPLER_WARMUP_PENALTY=1
HPU_GLM53_PENALTY_OUTPUT_BUCKET=64
HPU_GLM53_PENALTY_FOLD=check
HPU_GLM53_HBM_MARGIN_TIMED_REPLAYS=3
HPU_GLM53_DECODE_SPLIT_DROP_ROWS=
VLLM_GAUDI_TARGETED_SAMPLER_WARMUP_BATCHES=1,2,4,8,16
HPU_GLM53_QUERY_SHARD_DECODE_KEYS=4:1024
HPU_GLM53_CAPTURE_EXECUTE_KEYS=128:1024
HPU_GLM53_DEVICE_REPETITION_PENALTY=0
HPU_GLM53_DEFER_GRAPH_DESTROY=1
HPU_GLM53_WIDTH_SHARD_DECODE_KEYS=16x4096,4x4096,2x4096,1x4096,16x1024,2x1024,8x4096,8x1024
VLLM_RECURRENT_TAIL_FUSE_KEYED=1
HPU_GLM53_KEYED_LOGITS=1
HPU_GLM53_OFFLOAD_ROW_BUCKETS=1
HPU_GLM53_RESERVE_VECTOR=1
HPU_GLM53_RESERVE_SKIP_DISCARDED=1
VLLM_GAUDI_MIXED_PROMPT_KEYS=1536:4096,1536:1024,128:1024
HPU_GLM53_DECODE_KPOOL_TILE_CEILING_FOR=16x4096:32768,8x4096:32768,4x4096:65536,2x4096:65536
VLLM_BUCKETING_FROM_FILE=/opt/glm53/buckets/c64-r609-b64-decode-r1792.buckets
VLLM_GAUDI_BOOTSTRAP_DECODE_BUCKETS=1,1,128;2,1,256;4,1,512;8,1,1024;16,1,2048
VLLM_GAUDI_MIXED_PREFILL_TOKENS=1536
VLLM_ADAPTIVE_LONG_PREFILL_SINGLE_TOKENS=1536
HPU_GLM53_QUERY_SHARD_KEYS=1536:4096,1536:1024
VLLM_GAUDI_MIXED_DECODE_WIDTHS=1024,4096
HPU_GLM53_MOE_ORDERED_ACCUMULATE=1
HPU_GLM53_ROUTED_COPY_FREE_TILE=1536
HPU_GLM53_ROUTED_COPY_FREE_CHUNK=64
VLLM_MOE_CHUNK=32
VLLM_MOE_TOKEN_BOUNDARY=8192
HPU_GLM53_NATIVE_ROUTED_GPT_MAX_TOKENS=16
VLLM_DECODE_PRIORITY_MAX_SKIPPED_STEPS=8
HPU_GLM53_DECODE_PAD_CHECK_WIDTHS=
HPU_GLM53_DECODE_PAD_UNCOMPARED_WIDTHS=2048
HPU_GLM53_MLA_WINDOW=1
# tail-first prompt slot (2026-11-14): the prompt with the fewest chunks left is read first; needs the completion-first lane off.
VLLM_GAUDI_MIXED_TAIL_FIRST=1
VLLM_COMPLETION_FIRST_LONG_PREFILL=0
HPU_GLM53_ATTN_PIN=1
PT_HPU_POOL_MEM_ACQUIRE_PERC=99
VLLM_GAUDI_MIXED_GRAPH_RESERVE_MIB=1024
HPU_GLM53_POOL_LIMIT_MAX_MIB=96400
VLLM_GAUDI_MIXED_KEY_WORKSPACE_RELEASE_MODE=serial
HPU_GLM53_BREADCRUMB_FILE=/recipe_cache/glm53-breadcrumbs.log
