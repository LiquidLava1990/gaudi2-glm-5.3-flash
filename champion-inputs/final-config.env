# derived from /mnt/data1/declane-out/c1d-r4h5/r4h-proof-boot-config.env (e7c74cae) minus HPU_GLM53_ATTN_PIN=0: r4e_run refuses the key beside R4E_PIN_GATE=off; glm53_attn_pin.py:101 defaults unset to 0 (same served value)
# The final serving config for the r4d dual-replica test and soak (coordinator 2026-11-08 20:5x), appended after twonode_run.sh's lever
# set (lab.py: later wins) and frozen into the run dir at launch. The promotion kit builds the production unit from the test container's
# env and refuses any key whose value differs from this file (coordinator 21:0x): every verdict key is explicit here, nothing rides a default.
# FROZEN 2026-11-08 21:1x by the coordinator: only the V2 block and the decode-priority line may change after this, and only by the
# coordinator's decision (a change re-pins SHA256SUMS; graded covers the sha in Fable 3's CONFIG line).
#
# Margin lever d as the graded c1d-final boots it (diag-final CONFIG 21:01:14; r4d bakes 50f40932 + the indexer restore guard).
HPU_GLM53_HBM_MARGIN_MIB=512
HPU_GLM53_RUNAHEAD_MARGIN_MIB=512
HPU_GLM53_HBM_MARGIN_BALLAST=1
# Kpool ceilings (F4, det PASS 1012/1012 on bisect-ours 19:59:30): multi-batch parity with the unit env + the 4096-width decode entries.
HPU_GLM53_MULTI_BATCH_KPOOL_TILE_CEILING=16384
# Junction fix on (baked in c1d; explicit for parity with the graded run) and the tail fuse off (c1d_args 0; the unit env has it 1).
VLLM_RECURRENT_SIDECAR_PROMPT_END_ONLY=1
VLLM_RECURRENT_TAIL_FUSE=0
# Restore fence: sync (Design C stays OFF until its RCA).
GLM53_RESTORE_FENCE_MODE=sync
# Decode priority (lever 1): OFF unless the lever-1 tuned arm on B ADOPTs (decode p50 >= 1.5x, TTFT <= 1.3x, prefill >= 0.7x the rerun);
# then these four replace the 0: VLLM_DECODE_PRIORITY=phases VLLM_DECODE_PRIORITY_MIXED=1 VLLM_DECODE_PRIORITY_MIN_DECODE_STEPS=8
# VLLM_DECODE_PRIORITY_MAX_PREFILL_WAIT_S=8
VLLM_DECODE_PRIORITY=phases
# V2 load path (Fable 3 23036c88, baked in r4d): the PASS block is live by the coordinator's 21:1x call (graded c1d-final doubles as the
# early V2 check under real loads; 8 GLM53_LOADPATH_INSTALL lines, 0 errors on the combined rerun's boot 21:12:58). The fallback, by the
# coordinator only, is GLM53_LOADPATH_V2=0 with the five knobs removed.
GLM53_LOADPATH_V2=1
HPU_KV_OFFLOAD_STAGE_MB=128
HPU_KV_OFFLOAD_MAX_INFLIGHT=2
HPU_KV_OFFLOAD_PIN_STAGE=1
GLM53_LOADPATH_THREADS=4
GLM53_LOADPATH_DEPTH=8
VLLM_GAUDI_MIXED_PROMPT_KEYS=1024:8192,1024:1024,128:8192,128:1024
VLLM_DECODE_PRIORITY_MIXED=1
VLLM_DECODE_PRIORITY_MIN_DECODE_STEPS=8
VLLM_DECODE_PRIORITY_MAX_PREFILL_WAIT_S=8
# split-scan variant (coordinator 10:0x): no 8-row decode buckets, DROP_ROWS armed, split scan off; sampler warmup without 8 rows
VLLM_BUCKETING_FROM_FILE=/opt/glm53/buckets/c64-r609-b64-decode-r1792-no8.buckets
VLLM_GAUDI_BOOTSTRAP_DECODE_BUCKETS=1,1,128;2,1,256;4,1,512;16,1,2048
HPU_GLM53_DECODE_KPOOL_TILE_CEILING_FOR=16x8192:32768,4x8192:65536,2x8192:65536,16x4096:32768,4x4096:65536,2x4096:65536
HPU_GLM53_DECODE_SPLIT_DROP_ROWS=8
VLLM_GAUDI_TARGETED_SAMPLER_WARMUP_BATCHES=1,2,4,16
HPU_GLM53_QUERY_SHARD_DECODE_KEYS=4:1024
# r4h proof boot (coordinator 10:3x): capture fix, fold check, device penalty off; pin off, split scan off
HPU_GLM53_CAPTURE_EXECUTE_KEYS=128:1024,128:8192
HPU_GLM53_PENALTY_FOLD=check
HPU_GLM53_DEVICE_REPETITION_PENALTY=0
HPU_GLM53_WIDTH_SHARD_DECODE_KEYS=16x8192,4x8192,2x8192,1x8192,16x4096,4x4096,2x4096,1x4096,16x2048,4x2048,2x2048,16x1024,2x1024
HPU_GLM53_DEFER_GRAPH_DESTROY=1
HPU_GLM53_ROUTED_COPY_FREE=1
HPU_GLM53_WIDTH_SHARD_KEYS=128:1024
HPU_GLM53_PENALTY_PROMPT_SET_STOCK=1
HPU_GLM53_PENALTY_OUTPUT_BUCKET=64
VLLM_GAUDI_SAMPLER_WARMUP_PENALTY=1
HPU_GLM53_HBM_MARGIN_TIMED_REPLAYS=3
# r4g-h6eOC1 (coordinator 2026-11-11 00:3x): r4h6e baked moe-ordered-accumulate kit armed, the only change vs C1X final-config (22d08c52)
HPU_GLM53_MOE_ORDERED_ACCUMULATE=1
