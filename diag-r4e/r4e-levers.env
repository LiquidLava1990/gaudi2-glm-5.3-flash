# r4e lever lines, applied after final-config.env 40f987bd (later wins). Filled at the 02:15 handoff by the routed-MoE senior (S9 lines) and the
# re-read engineer (session pin); r4e_run.sh HALTs before any card time while a key of R4E_REQUIRED_KEYS is missing. One KEY=VALUE per line.
# Routed MoE (ROUTED_MOE_C1D_PLAN S9): VLLM_GAUDI_MIXED_PROMPT_MOE=ragged  HPU_GLM53_RAGGED_GRAPH_MOE=1  HPU_GLM53_RAGGED_GRAPH_TABLE=<sha-pinned table>
# Session pin (REREAD_C1D_PLAN): HPU_GLM53_REUSE_V2_FOR=<value from the re-read plan>
# Lever 1 tuned (coordinator 22:5x: env-only, baked in the image; replaces final-config.env's VLLM_DECODE_PRIORITY=0 for this arm only)
VLLM_DECODE_PRIORITY=phases
VLLM_DECODE_PRIORITY_MIXED=1
VLLM_DECODE_PRIORITY_MIN_DECODE_STEPS=8
VLLM_DECODE_PRIORITY_MAX_PREFILL_WAIT_S=8
# If the counter names differ from r4e_run.sh's defaults (ragged_pieces/ragged_overflows/ragged_reruns, REUSE_V2), pass ROUTED_LINE_RE,
# ROUTED_*_KEY and PIN_LIVE_RE at launch.
# r4e inputs (coordinator 2026-11-09 00:1x EST; baked by decode-lane/image/r4e-handover.manifest 0c8a6ae0):
# Mixed-step key swap (mixed-step/mixed-step.env 07041967): 256:1024 in, 128:8192 out; later wins over the twonode lever set's keys.
VLLM_GAUDI_MIXED_PROMPT_KEYS=1024:8192,1024:1024,256:1024,128:1024
# W1 v2 (diag-w1/v2/SHA256SUMS 01725ec0) is OUT of r4e. Penalty prompt set ed1cdb0f: the 01:45 one-node run read W1a_ACCEPT=FAIL
# (piece0/1 p50 675/1040 ms vs the 20 ms bar; no GLM53_PENALTY_PROMPT_SET_LIVE line: the hook installs only under FAST_GREEDY +
